# pixi environments
.pixi/*
!.pixi/config.toml

# pixi build/publish output -- `pixi build` writes the built package
# directly into the current directory by default
*.conda

# generated example output
examples/*.bmp
examples/*.png
examples/*.svg

# generated test artifacts
tests/_test_*.bmp
tests/_test_*.png

# modo doc-generator binary (scripts/install-modo.sh) and its
# `mojo doc` JSON input -- both regenerated by `pixi run docs`, not
# committed. docs-src/examples/*.png|svg ARE committed (copied from
# examples/*.png|svg by that same task) -- those are real site assets,
# not build output to regenerate on every clone.
.tools/
docs-src/*.json
