# pixi environments
.pixi/*
!.pixi/config.toml

# pixi build/publish output -- `pixi build` writes the built package
# directly into the current directory by default
*.conda

# generated example output
examples/*.bmp
examples/*.png
examples/*.svg

# generated test artifacts
tests/_test_*.bmp
tests/_test_*.png

# modo doc-generator binary (scripts/install-modo.sh) and its
# `mojo doc` JSON input -- regenerated by `pixi run docs`, not
# committed.
.tools/
docs/src/*.json

# docs/src/examples/ is entirely generated -- the .md pages by
# scripts/gen-example-docs.py (from examples/*.mojo's own docstrings/
# source), the images copied from examples/out_*.png|svg (themselves
# generated by `pixi run example`). Only docs/src/_index.md, the
# landing page, is real hand-written source. Modo's own generated Hugo
# content and Hugo's own built static site are generated too, from
# docs/src/ -- none of this is committed; all of it is deployed
# straight to GitHub Pages by .github/workflows/docs.yml's own
# Actions-based deploy, regenerated fresh on every run. docs/site/'s
# own Hugo *project* files (hugo.yaml, go.mod/go.sum) ARE committed --
# those are real source, not output.
docs/src/examples/
docs/site/content/
docs/site/public/
docs/site/*.lock
