# Pixi environment directory or worktree symlink.
.pixi

# pixi build/publish output -- `pixi build` writes the built package
# directly into the current directory by default
*.conda

# generated test artifacts
tests/_test_*.bmp
tests/_test_*.png

# modo doc-generator binary (scripts/install-modo.sh) and its
# `mojo doc` JSON input -- regenerated by `pixi run docs`, not
# committed.
.tools/
docs/src/*.json

# Generated example pages, programs, and images. Keep handwritten quickstart
# programs by re-including their directory one level at a time.
docs/src/examples/*
!docs/src/examples/quickstart
docs/src/examples/quickstart/*
!docs/src/examples/quickstart/*.mojo
# Generated cookbook and Hugo output.
docs/src/cookbook/
docs/site/content/
docs/site/public/
docs/site/*.lock
